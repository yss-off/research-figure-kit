{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/drawio-academic/figure-manifest-1.1.schema.json",
  "title": "Draw.io Academic Figure Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "figure_id",
    "title",
    "status",
    "contract",
    "semantic_inventory",
    "layout",
    "reference_selection",
    "render",
    "qa",
    "provenance"
  ],
  "properties": {
    "schema_version": {"enum": ["1.0", "1.1"]},
    "figure_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "title": {"type": "string", "minLength": 1},
    "status": {"enum": ["planning", "rendered", "review", "accepted"]},
    "contract": {
      "type": "object",
      "required": ["figure_type", "venue", "communication_goal", "intended_claim", "language", "palette", "color_policy", "print_target"],
      "properties": {
        "figure_type": {"enum": ["architecture", "workflow", "roadmap"]},
        "delivery_class": {"enum": ["pending", "raster-publication", "vector-submission", "draft-preview"]},
        "color_policy": {"enum": ["pending", "color", "grayscale", "black-white", "strict-black-white"]}
      },
      "additionalProperties": true
    },
    "semantic_inventory": {
      "type": "object",
      "required": ["nodes", "edges", "abbreviations", "formulas"],
      "properties": {
        "nodes": {"type": "array"},
        "edges": {"type": "array"},
        "abbreviations": {"type": "array"},
        "formulas": {"type": "array"},
        "non_edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "target", "reason"],
            "properties": {
              "source": {"type": "string"},
              "target": {"type": "string"},
              "reason": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "forbidden_inferences": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "statement", "prevention"],
            "properties": {
              "id": {"type": "string"},
              "statement": {"type": "string", "minLength": 1},
              "prevention": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "cross_cutting_regions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "semantic_role", "member_node_ids", "presentation_constraints"],
            "properties": {
              "id": {"type": "string"},
              "label": {"type": "string", "minLength": 1},
              "semantic_role": {"type": "string", "minLength": 1},
              "member_node_ids": {"type": "array", "items": {"type": "string"}},
              "presentation_constraints": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "layout": {
      "type": "object",
      "required": ["candidates", "selected_id", "selection_reason"],
      "properties": {
        "candidates": {"type": "array"},
        "selected_id": {"type": ["string", "null"]},
        "selection_reason": {"type": ["string", "null"]},
        "wireframe_gate": {
          "type": "object",
          "required": ["status", "review_artifact", "decision"],
          "properties": {
            "status": {"enum": ["pending", "approved", "not_applicable"]},
            "review_artifact": {"type": ["string", "null"]},
            "decision": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "reference_selection": {"type": "object"},
    "render": {"type": "object"},
    "qa": {
      "type": "object",
      "properties": {
        "review": {
          "type": "object",
          "required": ["path", "sha256", "schema_version"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "schema_version": {"const": "1.0"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "provenance": {"type": "object"}
  },
  "additionalProperties": false
}
